# Clew environment template: copy to .env and fill in; .env is never committed
# JWT signing key; must be replaced in production
SECRET_KEY=dev-secret-change-me
# JWT lifetime (hours)
JWT_EXPIRE_HOURS=24
# Data directory: holds the SQLite database and hosted source files
DATA_DIR=./data
# Initial administrator created on first start when the user table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Per-file upload size limit (MB); exceeding it returns 413
MAX_UPLOAD_MB=50
# Frontend origins allowed to call the API cross-origin (comma-separated; use real domains in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LLM provider (enabled for M4, OpenAI-compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
